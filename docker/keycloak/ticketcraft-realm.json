{
  "realm": "ticketcraft",
  "enabled": true,
  "displayName": "TicketCraft",

  "clients": [
    {
      "clientId": "ticketcraft-api",
      "name": "TicketCraft API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ticketcraft-postman",
      "name": "TicketCraft Postman",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/browser-callback"
      ],
      "webOrigins": [
        "https://oauth.pstmn.io"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "optionalClientScopes": [
        "orders.write",
        "orders.read",
        "metrics.read"
      ],
      "protocolMappers": [
        {
          "name": "ticketcraft-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticketcraft-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "user_id",
            "claim.name": "user_id",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    }
  ],

  "clientScopes": [
    {
      "name": "orders.write",
      "description": "Create TicketCraft orders",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "orders.read",
      "description": "Read TicketCraft orders",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "metrics.read",
      "description": "Read TicketCraft metrics",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],

  "users": [
    {
      "username": "e2e-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "E2E",
      "lastName": "User",
      "attributes": {
        "user_id": [
          "1001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "e2e-password",
          "temporary": false
        }
      ]
    }
  ]
}