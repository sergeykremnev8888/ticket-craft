# PostgreSQL
CATALOG_DB_USERNAME=catalog_user
CATALOG_DB_PASSWORD=catalog_user

ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=order_user

PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=payment_user

NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=notification_user

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Kafka: адрес внутри Docker-сети
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Redis: адрес внутри Docker-сети
REDIS_URL=redis://redis:6379

# Keycloak
JWT_ISSUER_URI=http://localhost:9000/realms/ticketcraft
JWT_JWK_SET_URI=http://keycloak:8080/realms/ticketcraft/protocol/openid-connect/certs
JWT_AUDIENCE=ticketcraft-api

# Маршруты Gateway
GATEWAY_CATALOG_URI=http://catalog-service:8081
GATEWAY_ORDER_URI=http://order-service:8082

# Платёжный эмулятор на компьютере
PAYMENT_PROVIDER_BASE_URL=http://host.docker.internal:8090

# Трассировка
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
