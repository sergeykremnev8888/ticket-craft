      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"api-gateway\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"api-gateway\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
